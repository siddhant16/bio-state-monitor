# EditorConfig helps maintain consistent coding styles for multiple developers
# See https://editorconfig.org for more information

root = true

# All files
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# JavaScript/TypeScript/JSX files
[*.{js,jsx,ts,tsx}]
indent_style = space
indent_size = 2
end_of_line = lf

# Java files
[*.java]
indent_style = space
indent_size = 4
end_of_line = lf

# JSON files
[*.json]
indent_style = space
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
